# Generate: python scripts/generate_secret_key.py
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
ENABLE_API_DOCS=True

# Production (when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_HSTS_SECONDS=31536000

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tododb
DB_USER=postgres
DB_PASS=postgres
DB_HOST=db
DB_PORT=5432

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email (smtp4dev in Docker Compose)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=False
EMAIL_HOST=smtp4dev
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=noreply@todo-app.com

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: password for fake data command demo user
# FAKE_USER_PASSWORD=ChangeMe-FakeData-123!
